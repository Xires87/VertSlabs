{
	"schemaVersion": 1,
	"id": "frycvertslabs",
	"version": "${version}",
	"name": "Vertical slabs for everyone",
	"description": "Just rotate a slab in your hand and place it - no new items are added",
	"authors": [
		"Xires87"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/Xires87/VertSlabs"
	},
	"license": "MIT",
	"icon": "assets/frycvertslabs/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.fryc.frycvertslabs.VertSlabs"
		],
		"fabric-datagen": [
			"net.fryc.frycvertslabs.datagen.VertSlabsDataGenerator"
		]
	},
	"mixins": [
		"frycvertslabs.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}